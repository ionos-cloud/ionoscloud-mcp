# IONOS Cloud MCP Server Configuration

# Token-based authentication (required)
IONOS_TOKEN=your-api-token-here

# Generate a token from https://dcd.ionos.com/ under Management > Token Management

# Optional: S3 credentials for Object Storage data-plane tools
# (list/inspect buckets, objects, access keys, etc.)
# Generate at: https://dcd.ionos.com → Object Storage → Access Keys
IONOS_S3_ACCESS_KEY=your-s3-access-key
IONOS_S3_SECRET_KEY=your-s3-secret-key