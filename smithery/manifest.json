{
  "manifest_version": "0.3",
  "name": "ionoscloud-mcp",
  "display_name": "IONOS CLOUD MCP Server",
  "version": "0.1.1",
  "description": "Inspect IONOS CLOUD infrastructure via MCP",
  "author": {
    "name": "IONOS CLOUD",
    "url": "https://github.com/ionos-cloud/ionoscloud-mcp"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionos-cloud/ionoscloud-mcp"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/run.sh",
    "mcp_config": {
      "command": "${__dirname}/server/run.sh",
      "args": [],
      "env": {
        "IONOS_TOKEN": "${user_config.ionos_token}",
        "IONOS_S3_ACCESS_KEY": "${user_config.ionos_s3_access_key}",
        "IONOS_S3_SECRET_KEY": "${user_config.ionos_s3_secret_key}",
        "IONOS_MCP_LOAD_MODE": "${user_config.ionos_mcp_load_mode}"
      },
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/bin/windows_amd64/ionoscloud-mcp.exe",
          "args": [],
          "env": {
            "IONOS_TOKEN": "${user_config.ionos_token}",
            "IONOS_S3_ACCESS_KEY": "${user_config.ionos_s3_access_key}",
            "IONOS_S3_SECRET_KEY": "${user_config.ionos_s3_secret_key}",
            "IONOS_MCP_LOAD_MODE": "${user_config.ionos_mcp_load_mode}"
          }
        }
      }
    }
  },
  "tools_generated": true,
  "keywords": ["ionos", "cloud", "infrastructure", "compute", "dns", "billing"],
  "license": "Apache-2.0",
  "user_config": {
    "ionos_token": {
      "type": "string",
      "title": "IONOS Token",
      "description": "IONOS CLOUD API token",
      "required": true,
      "sensitive": true
    },
    "ionos_s3_access_key": {
      "type": "string",
      "title": "S3 Access Key",
      "description": "S3 access key for IONOS Object Storage",
      "required": false,
      "sensitive": true
    },
    "ionos_s3_secret_key": {
      "type": "string",
      "title": "S3 Secret Key",
      "description": "S3 secret key for IONOS Object Storage",
      "required": false,
      "sensitive": true
    },
    "ionos_mcp_load_mode": {
      "type": "string",
      "title": "Tool Loading Mode",
      "description": "Tool registration strategy. 'eager' (default): all tools at startup. 'lazy': defer Compute and Object Storage behind sentinel loaders (requires MCP client support for notifications/tools/list_changed).",
      "required": false,
      "sensitive": false,
      "default": "eager"
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"]
  }
}
